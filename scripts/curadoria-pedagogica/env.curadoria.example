# Copie este arquivo para ".env.curadoria" (mesmo diretorio) e preencha com
# valores reais. ".env.curadoria" NUNCA deve ser versionado — ja e coberto
# pela regra ".env*" do .gitignore raiz do projeto (confirmado com
# `git check-ignore -v scripts/curadoria-pedagogica/.env.curadoria`).
#
# Usado por auditar-conteudo.mjs e gerar-pos-check.mjs — as duas UNICAS
# etapas deste pipeline que leem o Supabase (sempre so SELECT).
#
# SUPABASE_SERVICE_ROLE_KEY e obrigatoria (nao basta a chave anon):
# unidades_pedagogicas e questao_unidades_pedagogicas tem RLS fechado para
# anon/authenticated (ver supabase/unidades_pedagogicas.sql e
# supabase/questao_unidades_pedagogicas.sql).

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-chave-de-servico-real

# --- Usado por executar-sql.mjs (executor local de teste rollback / apply
# real / pos-check) ---
#
# Connection string direta do Postgres do Supabase — NAO e a mesma coisa
# que SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY acima (aquelas sao para a API
# REST via @supabase/supabase-js; esta e para conexao direta via node-postgres,
# necessaria para CREATE TEMPORARY TABLE / DO $$ ... $$ / ROLLBACK, que a
# API REST nao suporta).
#
# Como encontrar: painel do Supabase -> Project Settings -> Database ->
# Connection string -> "URI" (modo "Session" ou "Transaction", nao
# "Statement" — este executor roda scripts com estado de transacao/tabela
# temporaria, que exige uma sessao real, nao um pooler stateless).
#
# Inclua "?sslmode=require" no final se o Supabase nao ja incluir por
# padrao na string copiada do painel.
SUPABASE_DB_URL=postgresql://usuario:senha@db.SEU-PROJETO.supabase.co:5432/postgres?sslmode=require
