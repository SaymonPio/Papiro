# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.vinext/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
*.tsbuildinfo

# supabase
/supabase/.temp/

# curadoria pedagogica: relatorios de auditoria sao artefatos regeneraveis
# (node scripts/curadoria-pedagogica/auditar-conteudo.mjs <id>), nao devem
# ser versionados a cada conteudo
scripts/curadoria-pedagogica/relatorios/

# importador de provas (PoC): saida do dry-run e regeneravel a cada
# execucao (node scripts/importador-provas/cli.mjs); PDFs reais de prova/
# gabarito fornecidos por um administrador NUNCA devem ser versionados
# (conteudo de terceiros, sem direitos de redistribuicao confirmados)
scripts/importador-provas/output/
scripts/importador-provas/fixtures-reais/
scripts/importador-provas/*.pdf
scripts/importador-provas/staging/

# config local de agentes/MCP (especifica desta maquina, nunca compartilhada)
/.agents/
/.claude/
/.mcp.json
